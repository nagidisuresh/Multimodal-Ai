# OmniMind AI — Backend Environment Configuration (.env.example)
# Note: Keep secrets private. Do NOT commit .env with real credentials.

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=

# Multimodal AI (Google Gemini API — backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Database + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Security & Uploads
JWT_SECRET=
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=20
